# ---------------------------------------------------------------------------
# PR Reminder notification service - environment configuration (standalone mode)
# Copy to .env and fill in real values. NEVER commit .env.
# When the service is started by the VS Code extension, these values come from
# VS Code SecretStorage instead and this file is not needed.
# ---------------------------------------------------------------------------

# GitHub token: fine-grained PAT with read-only "Pull requests", "Contents"
# (metadata), "Commit statuses" and "Checks" permission on the monitored repos.
GITHUB_TOKEN=github_pat_REPLACE_ME

# Google Chat (reviewers get private DMs from YOUR Workspace account).
# OAuth client of type "Desktop app" from your Google Cloud project (Chat API enabled).
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-REPLACE_ME
# Refresh token: set the two values above, then run `npm run google-signin` and paste its output here.
GOOGLE_REFRESH_TOKEN=1//REPLACE_ME

# Bearer token clients must send to the service API. Use 32+ random chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PR_REMINDER_API_TOKEN=REPLACE_WITH_RANDOM_HEX

# Where the service listens. Keep 127.0.0.1 unless you put it behind TLS.
PR_REMINDER_HOST=127.0.0.1
PR_REMINDER_PORT=47615

# Non-secret configuration file and data directory (SQLite DB lives here)
PR_REMINDER_CONFIG=./examples/config.example.json
PR_REMINDER_DATA_DIR=./data

# debug | info | warn | error
PR_REMINDER_LOG_LEVEL=info
